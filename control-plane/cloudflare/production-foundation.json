{
  "version": 2,
  "account_id": "42586bf13b61436219d21def299833e4",
  "worker_name": "ordax-control-plane-v3",
  "r2_bucket": "ordax-device-artifacts",
  "hyperdrive_name": "ordax-control-plane-postgres",
  "postgres": {
    "project_ref": "jhfphsjptrpmtnzkpwud",
    "region": "sa-east-1",
    "runtime_role": "ordax_edge_executor",
    "runtime_transport": "hyperdrive",
    "hyperdrive_binding": "POSTGRES",
    "query_cache": "disabled"
  },
  "authorities": {
    "persistent": "postgresql",
    "artifacts": "r2",
    "realtime_session_coordination": "durable_objects"
  },
  "security": {
    "require_two_factor": true
  },
  "dns": {
    "zone": "ordax.com.br",
    "cutover_ready": false,
    "cutover_blockers": [
      "catalogo_media_dependency_not_removed"
    ]
  },
  "policy": {
    "allow_d1": false,
    "allow_dual_write": false,
    "forbidden_runtime_secrets": [
      "SUPABASE_SERVER_KEY",
      "SUPABASE_SERVICE_ROLE_KEY"
    ]
  },
  "deployment_ready": false,
  "readiness_blockers": [
    "cloudflare_r2_not_enabled",
    "hyperdrive_not_provisioned",
    "postgres_runtime_login_not_provisioned",
    "worker_hyperdrive_adapter_not_implemented",
    "worker_d1_cutover_incomplete",
    "product_auth_metadata_not_repointed",
    "workers_dev_subdomain_not_initialized",
    "cloudflare_ci_token_not_rotated",
    "cloudflare_2fa_not_enabled"
  ]
}
